  id: "$CELL_NAME"
  name: "Célula $CELL_NAME"
  description: "Workspace y gobierno declarativo de ingeniería para la célula $CELL_NAME"

configuration:
  language: "$LANG_CHOICE"
  locale: "$LANG_CHOICE"
  artifact_generation:
    functional_documentation: "$FUNC_LANG"
    technical_artifacts: "$TECH_LANG"

company:
  client_name: "Empresa Cliente"
  organization: "Área / Organización"
  compliance_level: "High / Regulated"
  vcs_provider: "GitHub / GitLab / Bitbucket"
  ci_provider: "Jenkins / GitHub Actions / GitLab CI"
  ticket_manager: "Jira / Azure DevOps"

business:
  domain: "Dominio funcional de la célula $CELL_NAME"
  target_users:
    - "Usuarios Web"
    - "Usuarios Mobile"
  core_glossary_ref: "knowledge/business-overview.md"

team:
